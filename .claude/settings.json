{
  "extraKnownMarketplaces": {
    "masseater-dev": {
      "source": {
        "source": "github",
        "repo": "masseater/masseater.dev"
      }
    }
  },
  "enabledPlugins": {
    "kogane@masseater-dev": true,
    "watashi@masseater-dev": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
