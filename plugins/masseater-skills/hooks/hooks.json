{
  "description": "masseater-skills plugin hooks",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-style-check.ts"],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__hearthbot__(update_progress_checklist|set_thread_resolved)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/task-graph.ts"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
