{
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Komorebi Store | 暮らしの道具のオンラインストア</title>\n<style>\n:root {\n  --bg: #faf9f7;\n  --surface: #ffffff;\n  --text: #22262b;\n  --muted: #6b7280;\n  --line: #e5e2dc;\n  --accent: #1f6f5c;\n  --accent-dark: #17574a;\n  --accent-soft: #e6f2ee;\n  --danger: #c0392b;\n  --sale: #c2410c;\n  --radius: 12px;\n  --shadow: 0 1px 2px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.05);\n}\n* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody {\n  margin: 0;\n  font-family: \"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, system-ui, sans-serif;\n  color: var(--text);\n  background: var(--bg);\n  line-height: 1.6;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\na { color: inherit; text-decoration: none; }\nbutton, input, select, textarea { font: inherit; color: inherit; }\nbutton { cursor: pointer; }\nh1, h2, h3, p { margin: 0; }\n.container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 20px; }\n:focus-visible { outline: 3px solid #8ac5b5; outline-offset: 2px; }\n\n/* ---------- header ---------- */\n.announce { background: var(--accent); color: #fff; font-size: 13px; text-align: center; padding: 6px 12px; }\nheader.site {\n  background: var(--surface);\n  border-bottom: 1px solid var(--line);\n  position: sticky; top: 0; z-index: 20;\n}\n.header-inner { display: flex; align-items: center; gap: 16px; height: 64px; }\n.logo { font-size: 20px; font-weight: 700; letter-spacing: .04em; white-space: nowrap; }\n.logo span { color: var(--accent); }\n.search { flex: 1; position: relative; max-width: 520px; margin: 0 auto; }\n.search input {\n  width: 100%; height: 40px; padding: 0 14px 0 38px;\n  border: 1px solid var(--line); border-radius: 999px; background: var(--bg);\n}\n.search::before { content: \"🔍\"; position: absolute; left: 13px; top: 50%; transform: translateY(-50%); font-size: 14px; opacity: .6; }\n.header-nav { display: flex; align-items: center; gap: 4px; }\n.nav-btn {\n  position: relative; display: inline-flex; align-items: center; gap: 6px;\n  padding: 8px 12px; border-radius: 8px; font-size: 14px; white-space: nowrap;\n}\n.nav-btn:hover { background: var(--bg); }\n.badge {\n  min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px;\n  background: var(--accent); color: #fff; font-size: 12px; font-weight: 700;\n  display: inline-flex; align-items: center; justify-content: center;\n}\n.badge[hidden] { display: none; }\n\n/* ---------- common ---------- */\nmain { flex: 1; padding: 28px 0 64px; }\nmain:focus { outline: none; }\n.page-title { font-size: 24px; margin-bottom: 20px; }\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n  height: 46px; padding: 0 22px; border-radius: 999px; border: 1px solid transparent;\n  background: var(--accent); color: #fff; font-weight: 700; transition: background .15s;\n}\n.btn:hover { background: var(--accent-dark); }\n.btn:disabled { background: #c9cdd2; cursor: not-allowed; }\n.btn.secondary { background: var(--surface); color: var(--text); border-color: var(--line); }\n.btn.secondary:hover { background: var(--bg); }\n.btn.block { width: 100%; }\n.btn.small { height: 36px; padding: 0 14px; font-size: 14px; }\n.link { color: var(--accent); text-decoration: underline; background: none; border: 0; padding: 0; }\n.muted { color: var(--muted); }\n.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }\n.breadcrumb { font-size: 13px; color: var(--muted); margin-bottom: 16px; }\n.breadcrumb a:hover { text-decoration: underline; }\n.empty { text-align: center; padding: 64px 20px; }\n.empty .icon { font-size: 48px; }\n.empty p { margin: 8px 0 20px; color: var(--muted); }\n\n/* ---------- hero ---------- */\n.hero {\n  background: linear-gradient(120deg, #e6f2ee, #f6efe2);\n  border-radius: var(--radius); padding: 36px 32px; margin-bottom: 28px;\n  display: flex; align-items: center; justify-content: space-between; gap: 20px;\n}\n.hero h1 { font-size: 28px; line-height: 1.35; }\n.hero p { margin-top: 8px; color: #4b5563; }\n.hero .art { font-size: 64px; letter-spacing: 8px; white-space: nowrap; }\n\n/* ---------- product list ---------- */\n.toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }\n.chips { display: flex; flex-wrap: wrap; gap: 8px; }\n.chip {\n  padding: 7px 16px; border-radius: 999px; border: 1px solid var(--line);\n  background: var(--surface); font-size: 14px;\n}\n.chip:hover { border-color: var(--accent); }\n.chip[aria-pressed=\"true\"] { background: var(--accent); border-color: var(--accent); color: #fff; }\n.sort { display: flex; align-items: center; gap: 8px; font-size: 14px; }\n.sort select, .field select, .qty-select {\n  height: 40px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface);\n}\n.result-count { font-size: 14px; color: var(--muted); margin-bottom: 12px; }\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }\n.product-card { overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .15s, transform .15s; }\n.product-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }\n.thumb {\n  aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center;\n  font-size: 72px; position: relative;\n  background: linear-gradient(135deg, hsl(var(--h) 55% 92%), hsl(calc(var(--h) + 40) 60% 84%));\n}\n.thumb.large { font-size: 160px; border-radius: var(--radius); aspect-ratio: 1 / 1; }\n.tag {\n  position: absolute; top: 10px; left: 10px; padding: 2px 10px; border-radius: 999px;\n  font-size: 12px; font-weight: 700; color: #fff; background: var(--sale);\n}\n.tag.soldout { background: #6b7280; }\n.tag.new { background: var(--accent); }\n.product-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }\n.product-cat { font-size: 12px; color: var(--muted); }\n.product-name { font-size: 15px; font-weight: 700; line-height: 1.45; }\n.rating { font-size: 13px; color: var(--muted); }\n.rating b { color: #d97706; font-weight: 700; }\n.price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 6px; }\n.price { font-size: 18px; font-weight: 700; }\n.price small { font-size: 12px; font-weight: 400; color: var(--muted); }\n.price.sale { color: var(--sale); }\n.old-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }\n.product-card .btn { margin-top: 10px; }\n\n/* ---------- product detail ---------- */\n.detail { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }\n.detail h1 { font-size: 26px; line-height: 1.4; margin: 4px 0 8px; }\n.detail .price { font-size: 30px; }\n.detail .desc { margin: 18px 0; }\n.spec { list-style: none; padding: 0; margin: 0 0 20px; border-top: 1px solid var(--line); font-size: 14px; }\n.spec li { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }\n.spec li span:first-child { width: 96px; color: var(--muted); flex-shrink: 0; }\n.buy-row { display: flex; gap: 12px; align-items: center; }\n.buy-row .btn { flex: 1; }\n.stock-note { font-size: 13px; margin-top: 10px; }\n.stock-note.low { color: var(--sale); }\n.perks { margin-top: 20px; padding: 14px 16px; background: var(--accent-soft); border-radius: var(--radius); font-size: 14px; }\n.section-title { font-size: 20px; margin: 48px 0 16px; }\n\n/* ---------- cart / checkout ---------- */\n.two-col { display: grid; grid-template-columns: 1fr 340px; gap: 28px; align-items: start; }\n.cart-item { display: grid; grid-template-columns: 96px 1fr auto; gap: 16px; padding: 16px; align-items: center; }\n.cart-item + .cart-item { border-top: 1px solid var(--line); }\n.cart-item .thumb { border-radius: 8px; font-size: 44px; aspect-ratio: 1 / 1; }\n.cart-item .name { font-weight: 700; }\n.cart-item .name:hover { text-decoration: underline; }\n.cart-item .controls { display: flex; align-items: center; gap: 14px; margin-top: 8px; font-size: 14px; }\n.cart-item .line-total { font-weight: 700; font-size: 17px; white-space: nowrap; }\n.stepper { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }\n.stepper button { width: 34px; height: 34px; border: 0; background: var(--surface); font-size: 16px; }\n.stepper button:hover:not(:disabled) { background: var(--bg); }\n.stepper button:disabled { color: #c9cdd2; cursor: not-allowed; }\n.stepper output { min-width: 34px; text-align: center; font-weight: 700; }\n.summary { padding: 20px; position: sticky; top: 84px; }\n.summary h2 { font-size: 17px; margin-bottom: 12px; }\n.summary dl { margin: 0; font-size: 14px; }\n.summary dl div { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; }\n.summary dd { margin: 0; white-space: nowrap; }\n.summary .total { border-top: 1px solid var(--line); margin-top: 8px; padding-top: 14px; font-size: 18px; font-weight: 700; }\n.summary .btn { margin-top: 16px; }\n.summary .hint { font-size: 13px; margin-top: 10px; padding: 8px 12px; background: var(--accent-soft); border-radius: 8px; }\n.summary .mini { font-size: 13px; padding: 4px 0; display: flex; justify-content: space-between; gap: 12px; }\n\n.form-section { padding: 22px; margin-bottom: 20px; }\n.form-section h2 { font-size: 17px; margin-bottom: 14px; }\n.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }\n.field { display: flex; flex-direction: column; gap: 5px; }\n.field.full { grid-column: 1 / -1; }\n.field label { font-size: 14px; font-weight: 700; }\n.req { color: var(--danger); font-size: 12px; margin-left: 6px; font-weight: 400; }\n.field input, .field select { height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); width: 100%; }\n.field [aria-invalid=\"true\"] { border-color: var(--danger); background: #fdf3f2; }\n.error { color: var(--danger); font-size: 13px; min-height: 0; }\n.radio { display: flex; gap: 12px; align-items: flex-start; padding: 14px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }\n.radio + .radio { margin-top: 10px; }\n.radio:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }\n.radio input { margin-top: 5px; accent-color: var(--accent); }\n.radio small { display: block; color: var(--muted); }\n.notice { font-size: 13px; padding: 10px 14px; border-radius: 8px; background: #fff7e6; border: 1px solid #f3dfb2; margin-bottom: 20px; }\n\n/* ---------- complete / orders ---------- */\n.complete { max-width: 640px; margin: 0 auto; padding: 36px 28px; text-align: center; }\n.complete .icon { font-size: 56px; }\n.complete h1 { font-size: 24px; margin: 8px 0; }\n.complete .order-no { display: inline-block; margin: 14px 0; padding: 8px 18px; background: var(--bg); border-radius: 8px; font-weight: 700; letter-spacing: .05em; }\n.complete .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 24px; }\n.order { padding: 18px 20px; margin-bottom: 16px; }\n.order-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 10px; font-size: 14px; }\n.order-line { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; padding: 3px 0; }\n.order-total { text-align: right; font-weight: 700; margin-top: 8px; }\n.ship-to { text-align: left; font-size: 14px; margin-top: 18px; padding: 14px 16px; background: var(--bg); border-radius: 8px; }\n\n/* ---------- footer / toast ---------- */\nfooter.site { background: #22262b; color: #cfd3d8; font-size: 13px; padding: 32px 0; }\n.footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; }\n.footer-inner strong { color: #fff; font-size: 15px; }\n.footer-inner ul { list-style: none; margin: 6px 0 0; padding: 0; }\n.footer-inner li { padding: 2px 0; }\n.copyright { margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a4047; color: #8b9198; }\n.toast {\n  position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px);\n  background: #22262b; color: #fff; padding: 12px 20px; border-radius: 999px; font-size: 14px;\n  box-shadow: var(--shadow); opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 50;\n  max-width: calc(100vw - 32px);\n}\n.toast.show { opacity: 1; transform: translate(-50%, 0); }\n\n@media (max-width: 820px) {\n  .detail, .two-col { grid-template-columns: 1fr; gap: 24px; }\n  .summary { position: static; }\n  .hero .art { display: none; }\n  .hero h1 { font-size: 22px; }\n}\n@media (max-width: 600px) {\n  .header-inner { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 10px; gap: 8px; }\n  .search { order: 3; flex-basis: 100%; max-width: none; }\n  .header-nav { margin-left: auto; }\n  .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n  .thumb { font-size: 52px; }\n  .form-grid { grid-template-columns: 1fr; }\n  .cart-item { grid-template-columns: 72px 1fr; }\n  .cart-item .line-total { grid-column: 2; }\n  .thumb.large { font-size: 110px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  * { transition: none !important; scroll-behavior: auto !important; }\n}\n</style>\n</head>\n<body>\n\n<div class=\"announce\">税込5,000円以上のご注文で送料無料 🚚</div>\n\n<header class=\"site\">\n  <div class=\"container header-inner\">\n    <a class=\"logo\" href=\"#/\" data-nav>Komorebi<span>.</span>Store</a>\n    <div class=\"search\" role=\"search\">\n      <input id=\"search\" type=\"search\" placeholder=\"商品名・キーワードで検索\" aria-label=\"商品を検索\" autocomplete=\"off\">\n    </div>\n    <nav class=\"header-nav\" aria-label=\"メインメニュー\">\n      <a class=\"nav-btn\" href=\"#/orders\" data-nav>📦 注文履歴</a>\n      <a class=\"nav-btn\" href=\"#/cart\" data-nav>🛒 カート <span class=\"badge\" id=\"cart-badge\" hidden>0</span></a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"app\" class=\"container\" tabindex=\"-1\"></main>\n\n<footer class=\"site\">\n  <div class=\"container\">\n    <div class=\"footer-inner\">\n      <div>\n        <strong>Komorebi Store</strong>\n        <p>毎日の暮らしを少しだけ心地よくする道具を集めました。</p>\n      </div>\n      <div>\n        <strong>ご利用ガイド</strong>\n        <ul>\n          <li>送料：全国一律 ¥550（税込5,000円以上で無料）</li>\n          <li>お支払い：クレジットカード／コンビニ払い／代金引換</li>\n          <li>返品：商品到着後8日以内（未使用品に限る）</li>\n        </ul>\n      </div>\n    </div>\n    <p class=\"copyright\">© 2026 Komorebi Store — これはデモサイトです。実際の注文・決済は行われません。</p>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n<script>\n'use strict';\n\n/* ===================== データ ===================== */\nconst PRODUCTS = [\n  { id: 'p01', name: 'コットン オーバーサイズTシャツ', cat: 'ファッション', price: 2980, emoji: '👕', hue: 200, stock: 24, rating: 4.4, reviews: 128, added: 3,\n    desc: '厚手のオーガニックコットンを使用した、ゆったりシルエットのTシャツ。洗濯を繰り返してもヨレにくく、一枚でもインナーとしても活躍します。',\n    spec: { '素材': '綿100%', 'サイズ': 'S / M / L', '原産国': '日本' } },\n  { id: 'p02', name: 'ヴィンテージ加工 デニムジャケット', cat: 'ファッション', price: 8800, oldPrice: 11000, emoji: '🧥', hue: 225, stock: 6, rating: 4.6, reviews: 57, added: 8,\n    desc: '程よい色落ち感が魅力のデニムジャケット。季節の変わり目に羽織りやすい、やや軽めの12オンス生地です。',\n    spec: { '素材': '綿100%', 'サイズ': 'M / L / XL', '原産国': '日本（岡山）' } },\n  { id: 'p03', name: 'レザースニーカー ホワイト', cat: 'ファッション', price: 12100, emoji: '👟', hue: 30, stock: 12, rating: 4.7, reviews: 203, added: 5,\n    desc: '上質な天然皮革を使ったミニマルなスニーカー。クッション性の高いインソールで長時間歩いても疲れにくい一足です。',\n    spec: { '素材': '牛革／ラバーソール', 'サイズ': '23.0〜28.0cm', '原産国': 'ポルトガル' } },\n  { id: 'p04', name: 'キャンバス トートバッグ', cat: 'ファッション', price: 3850, emoji: '👜', hue: 45, stock: 30, rating: 4.3, reviews: 89, added: 12,\n    desc: 'A4サイズやノートPCがすっぽり入る帆布トート。内ポケット付きで、通勤にも週末のお出かけにも。',\n    spec: { '素材': '綿（8号帆布）', 'サイズ': 'W38 × H36 × D12cm', '原産国': '日本' } },\n  { id: 'p05', name: 'ワイヤレスイヤホン ノイズキャンセリング', cat: '家電', price: 9900, oldPrice: 12800, emoji: '🎧', hue: 260, stock: 15, rating: 4.5, reviews: 412, added: 2,\n    desc: 'アクティブノイズキャンセリング搭載の完全ワイヤレスイヤホン。ケース併用で最大30時間再生、IPX4の防滴仕様です。',\n    spec: { '接続': 'Bluetooth 5.3', '再生時間': '本体8時間／ケース込み30時間', '保証': '1年間' } },\n  { id: 'p06', name: 'スマートウォッチ ヘルスケアモデル', cat: '家電', price: 24800, emoji: '⌚', hue: 280, stock: 4, rating: 4.2, reviews: 76, added: 1,\n    desc: '心拍・睡眠・運動を24時間記録。通知の確認やタッチ決済にも対応した、毎日使えるスマートウォッチです。',\n    spec: { '画面': '1.4インチ 有機EL', 'バッテリー': '最大7日間', '防水': '5気圧' } },\n  { id: 'p07', name: '全自動コーヒーメーカー', cat: 'キッチン', price: 6600, emoji: '☕', hue: 20, stock: 9, rating: 4.4, reviews: 164, added: 9,\n    desc: '豆から挽きたての一杯を。ミルの粗さは3段階、タイマー予約で朝の目覚めに合わせて淹れられます。',\n    spec: { '容量': '最大4杯（540ml）', 'サイズ': 'W17 × D28 × H30cm', '保証': '1年間' } },\n  { id: 'p08', name: 'ホーロー両手鍋 20cm', cat: 'キッチン', price: 7480, emoji: '🍲', hue: 8, stock: 0, rating: 4.8, reviews: 95, added: 15,\n    desc: '熱をじっくり伝える鋳物ホーロー鍋。煮込み料理や無水調理が得意で、そのまま食卓に出せる佇まいです。',\n    spec: { '素材': '鋳物ホーロー', '容量': '2.4L', '対応熱源': 'ガス／IH／オーブン' } },\n  { id: 'p09', name: 'ソイワックス アロマキャンドル', cat: 'インテリア', price: 2200, emoji: '🕯️', hue: 50, stock: 40, rating: 4.5, reviews: 231, added: 6,\n    desc: '大豆由来のワックスに天然精油をブレンド。ラベンダーとシダーウッドの落ち着いた香りが約40時間続きます。',\n    spec: { '内容量': '180g', '燃焼時間': '約40時間', '原産国': '日本' } },\n  { id: 'p10', name: '調光式 テーブルランプ', cat: 'インテリア', price: 5500, emoji: '💡', hue: 60, stock: 11, rating: 4.1, reviews: 48, added: 11,\n    desc: 'タッチで3段階に明るさを切り替えられるテーブルランプ。あたたかな電球色で、寝室や読書灯にぴったりです。',\n    spec: { '光源': 'LED（電球色）', 'サイズ': 'φ16 × H32cm', '電源': 'USB Type-C' } },\n  { id: 'p11', name: '観葉植物 モンステラ 6号鉢', cat: 'インテリア', price: 4180, emoji: '🪴', hue: 130, stock: 7, rating: 4.6, reviews: 112, added: 4,\n    desc: '切れ込みのある大きな葉が印象的なモンステラ。丈夫で育てやすく、はじめての観葉植物におすすめです。',\n    spec: { '高さ': '約60cm', '置き場所': '明るい室内', '水やり': '土が乾いたらたっぷり' } },\n  { id: 'p12', name: 'スペシャルティコーヒー豆 200g', cat: '食品', price: 1620, emoji: '🫘', hue: 25, stock: 50, rating: 4.7, reviews: 340, added: 7,\n    desc: 'エチオピア産の単一農園の豆を、注文後に焙煎してお届け。ベリーのような華やかな香りと明るい酸味が特徴です。',\n    spec: { '内容量': '200g（豆のまま）', '焙煎度': '中浅煎り', '賞味期限': '焙煎日より3か月' } },\n  { id: 'p13', name: '国産 百花はちみつ 300g', cat: '食品', price: 1980, emoji: '🍯', hue: 40, stock: 18, rating: 4.6, reviews: 87, added: 13,\n    desc: '信州の里山で採れた非加熱のはちみつ。季節の花々の蜜が混ざり合った、コクのあるやさしい甘さです。',\n    spec: { '内容量': '300g', '原産地': '長野県', '賞味期限': '製造日より2年' } },\n  { id: 'p14', name: '有機緑茶 ティーバッグ 30包', cat: '食品', price: 1080, oldPrice: 1280, emoji: '🍵', hue: 100, stock: 3, rating: 4.3, reviews: 152, added: 14,\n    desc: '静岡県産の有機栽培茶葉を使用。水出しでもお湯出しでも、手軽にすっきりとした味わいを楽しめます。',\n    spec: { '内容量': '2g × 30包', '原産地': '静岡県', '賞味期限': '製造日より1年' } },\n  { id: 'p15', name: '方眼ノート A5 糸かがり綴じ', cat: '文具', price: 880, emoji: '📓', hue: 340, stock: 60, rating: 4.4, reviews: 66, added: 10,\n    desc: '万年筆でも裏抜けしにくい上質紙を使用。180度フラットに開く糸かがり綴じで、書きやすさにこだわりました。',\n    spec: { 'サイズ': 'A5（148 × 210mm）', 'ページ数': '192ページ', '罫線': '5mm方眼' } },\n  { id: 'p16', name: '万年筆 細字 コンバーター付き', cat: '文具', price: 4400, emoji: '🖋️', hue: 215, stock: 8, rating: 4.5, reviews: 39, added: 16,\n    desc: 'なめらかな書き心地のステンレスペン先。カートリッジとコンバーターの両方に対応し、好みのインクを楽しめます。',\n    spec: { 'ペン先': 'ステンレス（細字）', '長さ': '約138mm', '付属品': 'コンバーター／カートリッジ1本' } },\n];\nconst CATEGORIES = ['すべて', ...new Set(PRODUCTS.map(p => p.cat))];\nconst PREFECTURES = ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'];\nconst PAYMENTS = {\n  card: { label: 'クレジットカード', note: 'デモのためカード情報の入力は不要です', fee: 0 },\n  cvs:  { label: 'コンビニ払い', note: 'ご注文後7日以内にお支払いください', fee: 0 },\n  cod:  { label: '代金引換', note: '代引き手数料 ¥330 がかかります', fee: 330 },\n};\nconst SHIPPING_FEE = 550;\nconst FREE_SHIPPING_OVER = 5000;\nconst MAX_QTY = 10;\n\n/* ===================== ユーティリティ ===================== */\nconst $ = (sel, root = document) => root.querySelector(sel);\nconst yen = n => '¥' + Number(n).toLocaleString('ja-JP');\nconst esc = s => String(s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst findProduct = id => PRODUCTS.find(p => p.id === id);\nconst maxQty = p => Math.min(p.stock, MAX_QTY);\n\n// localStorage が使えない環境（プレビュー等）ではメモリに保持する\nconst memory = {};\nconst storage = {\n  get(key, fallback) {\n    try {\n      const raw = localStorage.getItem(key);\n      if (raw !== null) return JSON.parse(raw);\n    } catch (e) { /* fall through */ }\n    return key in memory ? memory[key] : fallback;\n  },\n  set(key, value) {\n    memory[key] = value;\n    try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* ignore */ }\n  },\n};\n\nlet toastTimer;\nfunction toast(message) {\n  const el = $('#toast');\n  el.textContent = message;\n  el.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(() => el.classList.remove('show'), 2400);\n}\n\n/* ===================== 状態 ===================== */\nconst state = {\n  path: '/',\n  query: '',\n  category: 'すべて',\n  sort: 'recommended',\n  cart: loadCart(),\n};\n\nfunction loadCart() {\n  const saved = storage.get('ec.cart', []);\n  if (!Array.isArray(saved)) return [];\n  return saved\n    .map(item => {\n      const p = item && findProduct(item.id);\n      if (!p || p.stock <= 0) return null;\n      const qty = Math.max(1, Math.min(maxQty(p), Math.floor(Number(item.qty)) || 1));\n      return { id: p.id, qty };\n    })\n    .filter(Boolean);\n}\nfunction saveCart() {\n  storage.set('ec.cart', state.cart);\n  updateBadge();\n}\nfunction cartCount() { return state.cart.reduce((sum, i) => sum + i.qty, 0); }\nfunction cartLines() {\n  return state.cart.map(i => {\n    const p = findProduct(i.id);\n    return { product: p, qty: i.qty, total: p.price * i.qty };\n  });\n}\nfunction calcTotals(payment) {\n  const subtotal = cartLines().reduce((sum, l) => sum + l.total, 0);\n  const shipping = subtotal === 0 || subtotal >= FREE_SHIPPING_OVER ? 0 : SHIPPING_FEE;\n  const fee = payment && PAYMENTS[payment] ? PAYMENTS[payment].fee : 0;\n  return { subtotal, shipping, fee, total: subtotal + shipping + fee };\n}\nfunction updateBadge() {\n  const badge = $('#cart-badge');\n  const count = cartCount();\n  badge.textContent = count;\n  badge.hidden = count === 0;\n  badge.setAttribute('aria-label', `カート内 ${count} 点`);\n}\n\nfunction addToCart(id, qty = 1) {\n  const p = findProduct(id);\n  if (!p || p.stock <= 0) return;\n  const existing = state.cart.find(i => i.id === id);\n  const current = existing ? existing.qty : 0;\n  const next = Math.min(maxQty(p), current + qty);\n  if (next === current) {\n    toast(`「${p.name}」はこれ以上追加できません（上限 ${maxQty(p)} 点）`);\n    return;\n  }\n  if (existing) existing.qty = next; else state.cart.push({ id, qty: next });\n  saveCart();\n  toast(next - current < qty\n    ? `在庫の都合により ${next - current} 点のみカートに追加しました`\n    : `「${p.name}」をカートに追加しました`);\n}\nfunction setQty(id, qty) {\n  const item = state.cart.find(i => i.id === id);\n  const p = findProduct(id);\n  if (!item || !p) return;\n  item.qty = Math.max(1, Math.min(maxQty(p), qty));\n  saveCart();\n}\nfunction removeFromCart(id) {\n  state.cart = state.cart.filter(i => i.id !== id);\n  saveCart();\n}\n\n/* ===================== ルーティング ===================== */\nfunction currentHashPath() {\n  const h = location.hash.replace(/^#/, '');\n  return h.startsWith('/') ? h : '/';\n}\nfunction go(path) {\n  state.path = path;\n  try { if (currentHashPath() !== path) location.hash = path; } catch (e) { /* ignore */ }\n  render(true);\n}\nwindow.addEventListener('hashchange', () => {\n  const path = currentHashPath();\n  if (path !== state.path) { state.path = path; render(true); }\n});\n\nfunction render(navigated) {\n  const app = $('#app');\n  const parts = state.path.split('/').filter(Boolean).map(s => { try { return decodeURIComponent(s); } catch (e) { return s; } });\n  let html, title;\n  switch (parts[0]) {\n    case undefined:  [html, title] = [viewHome(), null]; break;\n    case 'product':  [html, title] = viewProduct(parts[1]); break;\n    case 'cart':     [html, title] = [viewCart(), 'カート']; break;\n    case 'checkout': [html, title] = [viewCheckout(), 'ご注文手続き']; break;\n    case 'complete': [html, title] = [viewComplete(parts[1]), 'ご注文完了']; break;\n    case 'orders':   [html, title] = [viewOrders(), '注文履歴']; break;\n    default:         [html, title] = [viewNotFound(), 'ページが見つかりません'];\n  }\n  app.innerHTML = html;\n  document.title = (title ? title + ' | ' : '') + 'Komorebi Store';\n  if (parts[0] === 'checkout') updateCheckoutSummary();\n  if (navigated) {\n    window.scrollTo(0, 0);\n    app.focus({ preventScroll: true });\n  }\n}\n\n/* ===================== ビュー：共通パーツ ===================== */\nfunction priceHtml(p) {\n  return `<span class=\"price${p.oldPrice ? ' sale' : ''}\">${yen(p.price)} <small>税込</small></span>` +\n    (p.oldPrice ? `<span class=\"old-price\">${yen(p.oldPrice)}</span>` : '');\n}\nfunction tagHtml(p) {\n  if (p.stock <= 0) return '<span class=\"tag soldout\">売り切れ</span>';\n  if (p.oldPrice) return `<span class=\"tag\">${Math.round((1 - p.price / p.oldPrice) * 100)}% OFF</span>`;\n  if (p.added <= 3) return '<span class=\"tag new\">NEW</span>';\n  return '';\n}\nfunction productCard(p) {\n  const href = `#/product/${p.id}`;\n  return `\n    <article class=\"card product-card\">\n      <a href=\"${href}\" data-nav aria-label=\"${esc(p.name)} の詳細を見る\">\n        <div class=\"thumb\" style=\"--h:${p.hue}\"><span aria-hidden=\"true\">${p.emoji}</span>${tagHtml(p)}</div>\n      </a>\n      <div class=\"product-body\">\n        <span class=\"product-cat\">${esc(p.cat)}</span>\n        <a class=\"product-name\" href=\"${href}\" data-nav>${esc(p.name)}</a>\n        <span class=\"rating\"><b>★ ${p.rating.toFixed(1)}</b>（${p.reviews}件）</span>\n        <div class=\"price-row\">${priceHtml(p)}</div>\n        <button class=\"btn small block\" data-action=\"add\" data-id=\"${p.id}\" ${p.stock <= 0 ? 'disabled' : ''}>\n          ${p.stock <= 0 ? '売り切れ' : 'カートに入れる'}\n        </button>\n      </div>\n    </article>`;\n}\nfunction summaryRows(t) {\n  return `\n    <div><dt>小計</dt><dd>${yen(t.subtotal)}</dd></div>\n    <div><dt>送料</dt><dd>${t.shipping === 0 ? '無料' : yen(t.shipping)}</dd></div>\n    ${t.fee ? `<div><dt>代引き手数料</dt><dd>${yen(t.fee)}</dd></div>` : ''}\n    <div class=\"total\"><dt>合計（税込）</dt><dd>${yen(t.total)}</dd></div>`;\n}\nfunction emptyState(icon, heading, text) {\n  return `\n    <div class=\"empty card\">\n      <div class=\"icon\" aria-hidden=\"true\">${icon}</div>\n      <h1 class=\"page-title\" style=\"margin:8px 0 0\">${heading}</h1>\n      <p>${text}</p>\n      <a class=\"btn\" href=\"#/\" data-nav>買い物を続ける</a>\n    </div>`;\n}\n\n/* ===================== ビュー：商品一覧 ===================== */\nfunction filteredProducts() {\n  const words = state.query.trim().toLowerCase().split(/\\s+/).filter(Boolean);\n  const list = PRODUCTS.filter(p => {\n    if (state.category !== 'すべて' && p.cat !== state.category) return false;\n    const haystack = (p.name + ' ' + p.cat + ' ' + p.desc).toLowerCase();\n    return words.every(w => haystack.includes(w));\n  });\n  const sorters = {\n    recommended: (a, b) => (b.stock > 0) - (a.stock > 0) || b.rating * Math.log(b.reviews) - a.rating * Math.log(a.reviews),\n    newest: (a, b) => a.added - b.added,\n    priceAsc: (a, b) => a.price - b.price,\n    priceDesc: (a, b) => b.price - a.price,\n    rating: (a, b) => b.rating - a.rating || b.reviews - a.reviews,\n  };\n  return list.sort(sorters[state.sort] || sorters.recommended);\n}\nfunction viewHome() {\n  const list = filteredProducts();\n  const filtering = state.query.trim() || state.category !== 'すべて';\n  const sortOptions = { recommended: 'おすすめ順', newest: '新着順', priceAsc: '価格の安い順', priceDesc: '価格の高い順', rating: '評価の高い順' };\n  return `\n    ${filtering ? '' : `\n    <section class=\"hero\">\n      <div>\n        <h1>暮らしを心地よくする、<br>ちょうどいい道具。</h1>\n        <p>ファッションからキッチン、文具まで。長く使えるものを選びました。</p>\n      </div>\n      <div class=\"art\" aria-hidden=\"true\">🪴☕🕯️</div>\n    </section>`}\n    <div class=\"toolbar\">\n      <div class=\"chips\" role=\"group\" aria-label=\"カテゴリで絞り込む\">\n        ${CATEGORIES.map(c => `<button class=\"chip\" data-action=\"category\" data-cat=\"${esc(c)}\" aria-pressed=\"${c === state.category}\">${esc(c)}</button>`).join('')}\n      </div>\n      <label class=\"sort\">並び替え\n        <select data-action=\"sort\">\n          ${Object.entries(sortOptions).map(([v, l]) => `<option value=\"${v}\" ${v === state.sort ? 'selected' : ''}>${l}</option>`).join('')}\n        </select>\n      </label>\n    </div>\n    <p class=\"result-count\" aria-live=\"polite\">\n      ${state.query.trim() ? `「${esc(state.query.trim())}」の検索結果：` : ''}${list.length} 件の商品\n    </p>\n    ${list.length\n      ? `<div class=\"grid\">${list.map(productCard).join('')}</div>`\n      : `<div class=\"empty card\">\n           <div class=\"icon\" aria-hidden=\"true\">🔎</div>\n           <p>条件に合う商品が見つかりませんでした。<br>キーワードやカテゴリを変えてお試しください。</p>\n           <button class=\"btn secondary\" data-action=\"reset-filter\">絞り込みを解除</button>\n         </div>`}`;\n}\n\n/* ===================== ビュー：商品詳細 ===================== */\nfunction viewProduct(id) {\n  const p = findProduct(id);\n  if (!p) return [viewNotFound(), '商品が見つかりません'];\n  const inCart = (state.cart.find(i => i.id === p.id) || {}).qty || 0;\n  const available = Math.max(0, maxQty(p) - inCart);\n  const related = PRODUCTS.filter(x => x.cat === p.cat && x.id !== p.id).slice(0, 4);\n  let stockNote;\n  if (p.stock <= 0) stockNote = '<p class=\"stock-note low\">現在売り切れです。再入荷をお待ちください。</p>';\n  else if (p.stock <= 5) stockNote = `<p class=\"stock-note low\">残り ${p.stock} 点 — お早めに</p>`;\n  else stockNote = '<p class=\"stock-note muted\">在庫あり・通常1〜2営業日で発送</p>';\n\n  const html = `\n    <nav class=\"breadcrumb\" aria-label=\"パンくずリスト\">\n      <a href=\"#/\" data-nav>ホーム</a> ／\n      <a href=\"#/\" data-nav data-action=\"category\" data-cat=\"${esc(p.cat)}\">${esc(p.cat)}</a> ／ ${esc(p.name)}\n    </nav>\n    <div class=\"detail\">\n      <div class=\"thumb large\" style=\"--h:${p.hue}\"><span aria-hidden=\"true\">${p.emoji}</span>${tagHtml(p)}</div>\n      <div>\n        <span class=\"product-cat\">${esc(p.cat)}</span>\n        <h1>${esc(p.name)}</h1>\n        <span class=\"rating\"><b>★ ${p.rating.toFixed(1)}</b>（レビュー ${p.reviews}件）</span>\n        <div class=\"price-row\" style=\"margin-top:12px\">${priceHtml(p)}</div>\n        <p class=\"desc\">${esc(p.desc)}</p>\n        <ul class=\"spec\">\n          ${Object.entries(p.spec).map(([k, v]) => `<li><span>${esc(k)}</span><span>${esc(v)}</span></li>`).join('')}\n        </ul>\n        <div class=\"buy-row\">\n          <select class=\"qty-select\" id=\"detail-qty\" aria-label=\"数量\" ${available === 0 ? 'disabled' : ''}>\n            ${Array.from({ length: Math.max(1, available) }, (_, i) => `<option value=\"${i + 1}\">${i + 1}</option>`).join('')}\n          </select>\n          <button class=\"btn\" data-action=\"add-detail\" data-id=\"${p.id}\" ${available === 0 ? 'disabled' : ''}>\n            ${p.stock <= 0 ? '売り切れ' : available === 0 ? '購入上限に達しています' : 'カートに入れる'}\n          </button>\n        </div>\n        ${stockNote}\n        ${inCart ? `<p class=\"stock-note\">カートに ${inCart} 点入っています。<a class=\"link\" href=\"#/cart\" data-nav>カートを見る</a></p>` : ''}\n        <div class=\"perks\">🚚 税込${FREE_SHIPPING_OVER.toLocaleString('ja-JP')}円以上で送料無料　／　↩️ 到着後8日以内は返品可能</div>\n      </div>\n    </div>\n    ${related.length ? `<h2 class=\"section-title\">同じカテゴリの商品</h2><div class=\"grid\">${related.map(productCard).join('')}</div>` : ''}`;\n  return [html, p.name];\n}\n\n/* ===================== ビュー：カート ===================== */\nfunction viewCart() {\n  const lines = cartLines();\n  if (!lines.length) return emptyState('🛒', 'カートは空です', '気になる商品をカートに入れてみましょう。');\n  const t = calcTotals();\n  const remaining = FREE_SHIPPING_OVER - t.subtotal;\n  return `\n    <h1 class=\"page-title\">ショッピングカート</h1>\n    <div class=\"two-col\">\n      <div class=\"card\">\n        ${lines.map(({ product: p, qty, total }) => `\n          <div class=\"cart-item\">\n            <a href=\"#/product/${p.id}\" data-nav tabindex=\"-1\" aria-hidden=\"true\">\n              <div class=\"thumb\" style=\"--h:${p.hue}\">${p.emoji}</div>\n            </a>\n            <div>\n              <a class=\"name\" href=\"#/product/${p.id}\" data-nav>${esc(p.name)}</a>\n              <div class=\"muted\" style=\"font-size:14px\">${yen(p.price)}（税込）</div>\n              <div class=\"controls\">\n                <span class=\"stepper\">\n                  <button data-action=\"dec\" data-id=\"${p.id}\" aria-label=\"${esc(p.name)} の数量を減らす\" ${qty <= 1 ? 'disabled' : ''}>−</button>\n                  <output aria-label=\"数量\">${qty}</output>\n                  <button data-action=\"inc\" data-id=\"${p.id}\" aria-label=\"${esc(p.name)} の数量を増やす\" ${qty >= maxQty(p) ? 'disabled' : ''}>＋</button>\n                </span>\n                <button class=\"link\" data-action=\"remove\" data-id=\"${p.id}\" aria-label=\"${esc(p.name)} をカートから削除\">削除</button>\n              </div>\n            </div>\n            <div class=\"line-total\">${yen(total)}</div>\n          </div>`).join('')}\n      </div>\n      <aside class=\"card summary\" aria-label=\"ご注文金額\">\n        <h2>ご注文金額</h2>\n        <dl>${summaryRows(t)}</dl>\n        ${remaining > 0\n          ? `<p class=\"hint\">あと <b>${yen(remaining)}</b> で送料無料になります</p>`\n          : '<p class=\"hint\">🎉 送料無料の対象です</p>'}\n        <a class=\"btn block\" href=\"#/checkout\" data-nav>レジに進む</a>\n        <a class=\"btn secondary block\" href=\"#/\" data-nav style=\"margin-top:10px\">買い物を続ける</a>\n      </aside>\n    </div>`;\n}\n\n/* ===================== ビュー：注文手続き ===================== */\nfunction field(name, label, attrs = '', opts = {}) {\n  const required = opts.optional ? '' : '<span class=\"req\">必須</span>';\n  const control = opts.options\n    ? `<select id=\"f-${name}\" name=\"${name}\" aria-describedby=\"e-${name}\" ${attrs}>\n         <option value=\"\">選択してください</option>\n         ${opts.options.map(o => `<option>${esc(o)}</option>`).join('')}\n       </select>`\n    : `<input id=\"f-${name}\" name=\"${name}\" aria-describedby=\"e-${name}\" ${attrs}>`;\n  return `\n    <div class=\"field${opts.full ? ' full' : ''}\">\n      <label for=\"f-${name}\">${label}${required}</label>\n      ${control}\n      <span class=\"error\" id=\"e-${name}\"></span>\n    </div>`;\n}\nfunction viewCheckout() {\n  if (!state.cart.length) return emptyState('🛒', 'カートは空です', 'ご注文手続きの前に、商品をカートに入れてください。');\n  return `\n    <nav class=\"breadcrumb\" aria-label=\"パンくずリスト\"><a href=\"#/cart\" data-nav>カート</a> ／ ご注文手続き</nav>\n    <h1 class=\"page-title\">ご注文手続き</h1>\n    <p class=\"notice\">⚠️ これはデモサイトです。実際の注文・決済・発送は行われません。入力内容はこのブラウザ内にのみ保存されます。</p>\n    <form id=\"checkout-form\" class=\"two-col\" novalidate>\n      <div>\n        <section class=\"card form-section\">\n          <h2>お届け先</h2>\n          <div class=\"form-grid\">\n            ${field('name', 'お名前', 'type=\"text\" autocomplete=\"name\" placeholder=\"山田 太郎\"', { full: true })}\n            ${field('email', 'メールアドレス', 'type=\"email\" autocomplete=\"email\" placeholder=\"taro@example.com\"')}\n            ${field('tel', '電話番号', 'type=\"tel\" autocomplete=\"tel\" inputmode=\"tel\" placeholder=\"090-1234-5678\"')}\n            ${field('zip', '郵便番号', 'type=\"text\" autocomplete=\"postal-code\" inputmode=\"numeric\" placeholder=\"100-0001\"')}\n            ${field('pref', '都道府県', 'autocomplete=\"address-level1\"', { options: PREFECTURES })}\n            ${field('address', '市区町村・番地', 'type=\"text\" autocomplete=\"address-line1\" placeholder=\"千代田区千代田1-1\"', { full: true })}\n            ${field('building', '建物名・部屋番号', 'type=\"text\" autocomplete=\"address-line2\"', { full: true, optional: true })}\n          </div>\n        </section>\n        <section class=\"card form-section\">\n          <h2 id=\"pay-heading\">お支払い方法</h2>\n          <div role=\"radiogroup\" aria-labelledby=\"pay-heading\">\n            ${Object.entries(PAYMENTS).map(([key, p], i) => `\n              <label class=\"radio\">\n                <input type=\"radio\" name=\"payment\" value=\"${key}\" ${i === 0 ? 'checked' : ''}>\n                <span><b>${p.label}</b><small>${p.note}</small></span>\n              </label>`).join('')}\n          </div>\n        </section>\n      </div>\n      <aside class=\"card summary\" aria-label=\"ご注文内容\">\n        <h2>ご注文内容</h2>\n        <div id=\"checkout-summary\"></div>\n        <button class=\"btn block\" type=\"submit\">注文を確定する</button>\n        <a class=\"btn secondary block\" href=\"#/cart\" data-nav style=\"margin-top:10px\">カートに戻る</a>\n      </aside>\n    </form>`;\n}\nfunction selectedPayment() {\n  const checked = $('#checkout-form input[name=\"payment\"]:checked');\n  return checked ? checked.value : 'card';\n}\nfunction updateCheckoutSummary() {\n  const box = $('#checkout-summary');\n  if (!box) return;\n  const t = calcTotals(selectedPayment());\n  box.innerHTML = `\n    ${cartLines().map(l => `<div class=\"mini\"><span>${esc(l.product.name)} × ${l.qty}</span><span>${yen(l.total)}</span></div>`).join('')}\n    <dl style=\"margin-top:10px;border-top:1px solid var(--line);padding-top:6px\">${summaryRows(t)}</dl>`;\n}\n\nconst VALIDATORS = {\n  name:    v => v ? '' : 'お名前を入力してください',\n  email:   v => !v ? 'メールアドレスを入力してください' : /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v) ? '' : 'メールアドレスの形式が正しくありません',\n  tel:     v => !v ? '電話番号を入力してください' : /^0\\d{9,10}$/.test(v.replace(/[-\\s]/g, '')) ? '' : '電話番号は0から始まる10〜11桁で入力してください',\n  zip:     v => !v ? '郵便番号を入力してください' : /^\\d{3}-?\\d{4}$/.test(v) ? '' : '郵便番号は7桁で入力してください（例：100-0001）',\n  pref:    v => v ? '' : '都道府県を選択してください',\n  address: v => v ? '' : '市区町村・番地を入力してください',\n};\n// 全角英数字・記号を半角にそろえる（メール・電話・郵便番号用）\nconst normalize = v => v.trim()\n  .replace(/[０-９Ａ-Ｚａ-ｚ＠．]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0))\n  .replace(/[‐－―ー−]/g, '-');\nfunction validateField(input) {\n  const check = VALIDATORS[input.name];\n  if (!check) return true;\n  const value = ['email', 'tel', 'zip'].includes(input.name) ? normalize(input.value) : input.value.trim();\n  const message = check(value);\n  input.setAttribute('aria-invalid', message ? 'true' : 'false');\n  $('#e-' + input.name).textContent = message;\n  return !message;\n}\nfunction submitOrder(form) {\n  const inputs = Object.keys(VALIDATORS).map(n => form.elements[n]);\n  const invalid = inputs.filter(input => !validateField(input));\n  if (invalid.length) {\n    invalid[0].focus();\n    toast('入力内容をご確認ください');\n    return;\n  }\n  if (!state.cart.length) { go('/cart'); return; }\n  const val = n => form.elements[n].value.trim();\n  const payment = selectedPayment();\n  const totals = calcTotals(payment);\n  const now = new Date();\n  const order = {\n    id: 'KS' + now.toISOString().slice(2, 10).replace(/-/g, '') + '-' + Math.random().toString(36).slice(2, 7).toUpperCase(),\n    date: now.toISOString(),\n    items: cartLines().map(l => ({ id: l.product.id, name: l.product.name, price: l.product.price, qty: l.qty })),\n    totals,\n    payment,\n    shipTo: {\n      name: val('name'),\n      email: normalize(val('email')),\n      tel: normalize(val('tel')),\n      zip: normalize(val('zip')).replace(/^(\\d{3})(\\d{4})$/, '$1-$2'),\n      pref: val('pref'),\n      address: val('address'),\n      building: val('building'),\n    },\n  };\n  storage.set('ec.orders', [order, ...loadOrders()]);\n  state.cart = [];\n  saveCart();\n  go('/complete/' + order.id);\n}\n\n/* ===================== ビュー：完了・注文履歴 ===================== */\nfunction loadOrders() {\n  const orders = storage.get('ec.orders', []);\n  return Array.isArray(orders) ? orders.filter(o => o && o.id && Array.isArray(o.items) && o.totals && o.shipTo) : [];\n}\nconst formatDate = iso => {\n  const d = new Date(iso);\n  return isNaN(d) ? '' : `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;\n};\nconst paymentLabel = key => (PAYMENTS[key] || { label: '—' }).label;\n\nfunction viewComplete(orderId) {\n  const order = loadOrders().find(o => o.id === orderId);\n  if (!order) return viewNotFound();\n  const s = order.shipTo;\n  return `\n    <div class=\"card complete\">\n      <div class=\"icon\" aria-hidden=\"true\">✅</div>\n      <h1>ご注文ありがとうございます</h1>\n      <p class=\"muted\">ご注文を承りました（デモのため、実際の発送・請求はありません）。</p>\n      <div class=\"order-no\">注文番号：${esc(order.id)}</div>\n      <div class=\"ship-to\">\n        <b>お届け先</b><br>\n        ${esc(s.name)} 様<br>\n        〒${esc(s.zip)} ${esc(s.pref)}${esc(s.address)} ${esc(s.building || '')}<br>\n        <b>お支払い方法</b>：${paymentLabel(order.payment)}　／　<b>合計</b>：${yen(order.totals.total)}\n      </div>\n      <div class=\"actions\">\n        <a class=\"btn\" href=\"#/\" data-nav>買い物を続ける</a>\n        <a class=\"btn secondary\" href=\"#/orders\" data-nav>注文履歴を見る</a>\n      </div>\n    </div>`;\n}\nfunction viewOrders() {\n  const orders = loadOrders();\n  if (!orders.length) return emptyState('📦', '注文履歴はまだありません', 'ご注文いただくと、こちらに履歴が表示されます。');\n  return `\n    <h1 class=\"page-title\">注文履歴</h1>\n    ${orders.map(o => `\n      <article class=\"card order\">\n        <div class=\"order-head\">\n          <span><b>${esc(o.id)}</b></span>\n          <span class=\"muted\">${formatDate(o.date)}　${paymentLabel(o.payment)}</span>\n        </div>\n        ${o.items.map(i => `\n          <div class=\"order-line\">\n            <span>${esc(i.name)} × ${Number(i.qty) || 0}</span>\n            <span>${yen((Number(i.price) || 0) * (Number(i.qty) || 0))}</span>\n          </div>`).join('')}\n        <div class=\"order-line muted\"><span>送料${o.totals.fee ? '・手数料' : ''}</span><span>${yen((Number(o.totals.shipping) || 0) + (Number(o.totals.fee) || 0))}</span></div>\n        <div class=\"order-total\">合計 ${yen(Number(o.totals.total) || 0)}</div>\n      </article>`).join('')}`;\n}\nfunction viewNotFound() {\n  return emptyState('🧭', 'ページが見つかりません', 'お探しのページは移動または削除された可能性があります。');\n}\n\n/* ===================== イベント ===================== */\ndocument.addEventListener('click', e => {\n  const actionEl = e.target.closest('[data-action]');\n  const navEl = e.target.closest('a[data-nav]');\n\n  if (actionEl && actionEl.tagName !== 'SELECT') {\n    const { action, id } = actionEl.dataset;\n    switch (action) {\n      case 'add': addToCart(id); break;\n      case 'add-detail': {\n        addToCart(id, Number($('#detail-qty').value) || 1);\n        render(false);\n        break;\n      }\n      case 'inc': case 'dec': {\n        const item = state.cart.find(i => i.id === id);\n        if (item) setQty(id, item.qty + (action === 'inc' ? 1 : -1));\n        render(false);\n        // 再描画後も同じボタン（無効化された場合は反対側）にフォーカスを戻す\n        const again = $(`[data-action=\"${action}\"][data-id=\"${id}\"]`);\n        if (again) (again.disabled ? $(`[data-action=\"${action === 'inc' ? 'dec' : 'inc'}\"][data-id=\"${id}\"]`) : again).focus();\n        break;\n      }\n      case 'remove': {\n        const p = findProduct(id);\n        removeFromCart(id);\n        render(false);\n        $('#app').focus({ preventScroll: true });\n        if (p) toast(`「${p.name}」をカートから削除しました`);\n        break;\n      }\n      case 'category':\n        state.category = actionEl.dataset.cat;\n        if (!navEl) render(false);\n        break;\n      case 'reset-filter':\n        state.query = '';\n        state.category = 'すべて';\n        $('#search').value = '';\n        render(false);\n        break;\n    }\n  }\n\n  if (navEl && !e.metaKey && !e.ctrlKey && !e.shiftKey && e.button === 0) {\n    e.preventDefault();\n    const path = navEl.getAttribute('href').replace(/^#/, '') || '/';\n    if (navEl.classList.contains('logo')) {\n      state.query = '';\n      state.category = 'すべて';\n      $('#search').value = '';\n    }\n    go(path);\n  }\n});\n\ndocument.addEventListener('change', e => {\n  if (e.target.matches('[data-action=\"sort\"]')) {\n    state.sort = e.target.value;\n    render(false);\n    $('[data-action=\"sort\"]').focus();\n  } else if (e.target.matches('input[name=\"payment\"]')) {\n    updateCheckoutSummary();\n  }\n});\n\ndocument.addEventListener('focusout', e => {\n  if (e.target.form && e.target.form.id === 'checkout-form' && e.target.value) validateField(e.target);\n});\ndocument.addEventListener('input', e => {\n  if (e.target.form && e.target.form.id === 'checkout-form' && e.target.getAttribute('aria-invalid') === 'true') validateField(e.target);\n});\ndocument.addEventListener('submit', e => {\n  if (e.target.id === 'checkout-form') {\n    e.preventDefault();\n    submitOrder(e.target);\n  }\n});\n\n$('#search').addEventListener('input', e => {\n  state.query = e.target.value;\n  // 入力中のフォーカスを奪わないよう、go() を使わずに一覧へ切り替える\n  if (state.path !== '/') {\n    state.path = '/';\n    try { location.hash = '/'; } catch (err) { /* ignore */ }\n  }\n  render(false);\n});\n$('#search').addEventListener('keydown', e => {\n  if (e.key === 'Enter') { e.preventDefault(); if (state.path !== '/') go('/'); }\n});\n\n/* ===================== 起動 ===================== */\nstate.path = currentHashPath();\nupdateBadge();\nrender(false);\n</script>\n</body>\n</html>\n"
  }
}
