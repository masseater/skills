{
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ひなたマーケット | 暮らしを彩るオンラインストア</title>\n<style>\n:root {\n  --bg: #f7f6f3; --surface: #fff; --text: #22252a; --muted: #6b7280; --line: #e5e3de;\n  --brand: #d9622b; --brand-dark: #b94d1c; --accent: #1f6f5c; --danger: #c0392b;\n  --radius: 12px; --shadow: 0 1px 3px rgba(0,0,0,.08), 0 4px 14px rgba(0,0,0,.05);\n}\n* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; background: var(--bg); color: var(--text); line-height: 1.6;\n  font-family: \"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, system-ui, sans-serif; }\na { color: inherit; text-decoration: none; }\nbutton, input, select, textarea { font: inherit; color: inherit; }\nbutton { cursor: pointer; }\n:focus-visible { outline: 3px solid #f2a97f; outline-offset: 2px; }\n.wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }\n\n/* ヘッダー */\n.notice { background: var(--accent); color: #fff; text-align: center; font-size: 13px; padding: 6px 12px; }\nheader.site { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }\n.head { display: flex; align-items: center; gap: 20px; padding: 14px 20px; flex-wrap: wrap; }\n.logo { font-weight: 800; font-size: 21px; letter-spacing: .02em; white-space: nowrap; }\n.logo span { color: var(--brand); }\n.search { flex: 1 1 240px; position: relative; }\n.search input { width: 100%; padding: 10px 14px 10px 38px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); }\n.search::before { content: \"🔍\"; position: absolute; left: 13px; top: 50%; transform: translateY(-50%); font-size: 14px; opacity: .6; }\nnav.main { display: flex; align-items: center; gap: 4px; font-size: 14px; }\nnav.main a { padding: 8px 12px; border-radius: 8px; white-space: nowrap; }\nnav.main a:hover { background: var(--bg); }\nnav.main a.on { color: var(--brand); font-weight: 700; }\n.cart-link { position: relative; background: var(--text); color: #fff !important; font-weight: 700; }\n.cart-link:hover { background: #000 !important; }\n.badge { display: inline-block; min-width: 20px; padding: 0 6px; margin-left: 6px; border-radius: 999px; background: var(--brand); color: #fff; font-size: 12px; text-align: center; }\n.badge[hidden] { display: none; }\n\n/* 共通 */\nmain { padding: 28px 0 64px; min-height: 60vh; }\nh1 { font-size: 24px; margin: 0 0 20px; }\nh2 { font-size: 18px; margin: 32px 0 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 20px; border: 1px solid transparent; border-radius: 10px; background: var(--brand); color: #fff; font-weight: 700; transition: background .15s; }\n.btn:hover { background: var(--brand-dark); }\n.btn:disabled { background: #c9c7c2; cursor: not-allowed; }\n.btn.ghost { background: var(--surface); color: var(--text); border-color: var(--line); }\n.btn.ghost:hover { background: var(--bg); }\n.btn.block { width: 100%; }\n.btn.sm { padding: 8px 12px; font-size: 13px; }\n.muted { color: var(--muted); font-size: 13px; }\n.price { font-weight: 800; font-size: 18px; }\n.price small { font-weight: 400; font-size: 11px; color: var(--muted); margin-left: 3px; }\n.stars { color: #e8a317; letter-spacing: 1px; font-size: 13px; }\n.stars span { color: var(--muted); letter-spacing: 0; margin-left: 4px; }\n.card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }\n.empty { text-align: center; padding: 64px 20px; }\n.empty .big { font-size: 48px; }\n.crumbs { font-size: 13px; color: var(--muted); margin-bottom: 16px; }\n.crumbs a:hover { text-decoration: underline; }\n\n/* ヒーロー */\n.hero { background: linear-gradient(120deg, #fbe3d3, #f9f1d8 55%, #d9efe6); border-radius: 18px; padding: 36px 32px; margin-bottom: 26px; }\n.hero h1 { font-size: 28px; margin: 0 0 6px; }\n.hero p { margin: 0; color: #4b5563; }\n\n/* 一覧 */\n.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }\n.chips { display: flex; gap: 8px; flex-wrap: wrap; }\n.chip { padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: 14px; }\n.chip[aria-pressed=\"true\"] { background: var(--text); color: #fff; border-color: var(--text); }\n.sort select { padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }\n.item { display: flex; flex-direction: column; overflow: hidden; position: relative; transition: transform .15s, box-shadow .15s; }\n.item:hover { transform: translateY(-3px); box-shadow: 0 2px 6px rgba(0,0,0,.1), 0 10px 24px rgba(0,0,0,.08); }\n.thumb { aspect-ratio: 4 / 3; display: grid; place-items: center; font-size: 72px; background: linear-gradient(135deg, hsl(var(--h) 70% 92%), hsl(calc(var(--h) + 40) 65% 84%)); }\n.item .body { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }\n.item .name { font-weight: 700; font-size: 15px; line-height: 1.4; }\n.item .name:hover { color: var(--brand); }\n.item .foot { margin-top: auto; padding-top: 8px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n.tag { position: absolute; top: 10px; left: 10px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }\n.tag.sold { background: #6b7280; }\n.fav { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border-radius: 50%; border: none; background: rgba(255,255,255,.9); font-size: 17px; line-height: 1; color: #9ca3af; }\n.fav[aria-pressed=\"true\"] { color: #e0364f; }\n\n/* 商品詳細 */\n.detail { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; padding: 28px; }\n.detail .thumb { border-radius: var(--radius); font-size: 150px; aspect-ratio: 1; }\n.detail h1 { margin-bottom: 8px; }\n.detail .price { font-size: 30px; margin: 14px 0 4px; }\n.buy { display: flex; gap: 10px; margin: 20px 0; flex-wrap: wrap; align-items: center; }\n.qty { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--surface); }\n.qty button { width: 36px; border: none; background: none; font-size: 18px; }\n.qty button:hover { background: var(--bg); }\n.qty input, .qty output { width: 44px; text-align: center; border: none; padding: 8px 0; background: none; -moz-appearance: textfield; display: grid; place-items: center; }\n.qty input::-webkit-outer-spin-button, .qty input::-webkit-inner-spin-button { -webkit-appearance: none; }\n.spec { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 12px; }\n.spec th, .spec td { text-align: left; padding: 9px 4px; border-top: 1px solid var(--line); }\n.spec th { width: 110px; color: var(--muted); font-weight: 400; }\n.in-stock { color: var(--accent); font-weight: 700; font-size: 14px; }\n.out-stock { color: var(--danger); font-weight: 700; font-size: 14px; }\n\n/* カート・購入手続き */\n.cols { display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start; }\n.rows { padding: 4px 20px; }\n.row { display: grid; grid-template-columns: 84px 1fr auto; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); align-items: center; }\n.row:last-child { border-bottom: none; }\n.row .thumb { border-radius: 10px; font-size: 38px; aspect-ratio: 1; }\n.row .ctl { display: flex; gap: 12px; align-items: center; margin-top: 8px; flex-wrap: wrap; }\n.link { background: none; border: none; padding: 0; color: var(--muted); font-size: 13px; text-decoration: underline; }\n.link:hover { color: var(--danger); }\n.summary { padding: 22px; position: sticky; top: 96px; }\n.summary h2 { margin-top: 0; }\n.summary dl { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin: 0 0 14px; font-size: 14px; }\n.summary dd { margin: 0; text-align: right; }\n.summary .total { border-top: 1px solid var(--line); padding-top: 12px; font-size: 18px; font-weight: 800; }\n.ship-hint { background: #eef7f3; color: var(--accent); border-radius: 8px; padding: 8px 12px; font-size: 13px; margin-bottom: 14px; }\n.mini { list-style: none; margin: 0 0 14px; padding: 0; font-size: 14px; }\n.mini li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; }\nform.checkout { padding: 24px; }\nfieldset { border: none; padding: 0; margin: 0 0 26px; }\nlegend { font-weight: 800; font-size: 17px; padding: 0; margin-bottom: 12px; }\n.field { margin-bottom: 14px; }\n.field label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 5px; }\n.req { color: var(--danger); font-size: 11px; margin-left: 6px; font-weight: 400; }\n.field input, .field select, .field textarea { width: 100%; padding: 10px 12px; border: 1px solid #cfccc5; border-radius: 8px; background: var(--surface); }\n.field [aria-invalid=\"true\"] { border-color: var(--danger); background: #fdf3f2; }\n.err { color: var(--danger); font-size: 13px; margin-top: 4px; min-height: 0; }\n.two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n.radio { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; cursor: pointer; }\n.radio:has(input:checked) { border-color: var(--brand); background: #fdf5f0; }\n.radio input { accent-color: var(--brand); }\n.done { max-width: 640px; margin: 0 auto; padding: 36px 28px; text-align: center; }\n.done .mini, .done .summary-box { text-align: left; }\n.order { padding: 20px; margin-bottom: 16px; }\n.order-head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; font-size: 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px; margin-bottom: 8px; }\n\n/* トースト・フッター */\n#toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 20px); background: var(--text); color: #fff; padding: 12px 20px; border-radius: 999px; font-size: 14px; opacity: 0; pointer-events: none; transition: .25s; z-index: 50; max-width: 90vw; }\n#toast.show { opacity: 1; transform: translate(-50%, 0); }\nfooter.site { background: #23262b; color: #c9ccd1; font-size: 13px; padding: 36px 0 28px; }\n.fcols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; margin-bottom: 24px; }\nfooter h3 { color: #fff; font-size: 14px; margin: 0 0 8px; }\nfooter ul { list-style: none; padding: 0; margin: 0; }\nfooter li { padding: 2px 0; }\n.copy { border-top: 1px solid #3a3e45; padding-top: 16px; text-align: center; color: #8b9098; }\n\n@media (max-width: 820px) {\n  .detail, .cols { grid-template-columns: 1fr; }\n  .detail { padding: 18px; gap: 18px; }\n  .summary { position: static; }\n  .head { gap: 12px; }\n  .search { order: 3; flex-basis: 100%; }\n  nav.main { margin-left: auto; }\n  nav.main a { padding: 8px; }\n  .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n  .thumb { font-size: 54px; }\n  .hero { padding: 24px 20px; }\n  .hero h1 { font-size: 22px; }\n}\n@media (max-width: 480px) {\n  .two { grid-template-columns: 1fr; }\n  .row { grid-template-columns: 64px 1fr; }\n  .row .line-total { grid-column: 2; }\n  .item .foot { flex-direction: column; align-items: stretch; }\n}\n@media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }\n</style>\n</head>\n<body>\n<div class=\"notice\">🚚 5,000円（税込）以上のご注文で送料無料</div>\n<header class=\"site\">\n  <div class=\"wrap head\">\n    <a class=\"logo\" href=\"#/\">ひなた<span>マーケット</span></a>\n    <div class=\"search\">\n      <input id=\"q\" type=\"search\" placeholder=\"商品名・キーワードで検索\" aria-label=\"商品を検索\" autocomplete=\"off\">\n    </div>\n    <nav class=\"main\" aria-label=\"メインメニュー\">\n      <a href=\"#/\" data-nav=\"\">商品一覧</a>\n      <a href=\"#/favorites\" data-nav=\"favorites\">お気に入り</a>\n      <a href=\"#/orders\" data-nav=\"orders\">注文履歴</a>\n      <a href=\"#/cart\" data-nav=\"cart\" class=\"cart-link\">🛒 カート<span class=\"badge\" id=\"badge\" hidden>0</span></a>\n    </nav>\n  </div>\n</header>\n\n<main><div class=\"wrap\" id=\"app\" aria-live=\"polite\"></div></main>\n\n<footer class=\"site\">\n  <div class=\"wrap\">\n    <div class=\"fcols\">\n      <div><h3>ひなたマーケット</h3><p>毎日の暮らしを少し心地よくする、衣・食・住のアイテムをお届けします。</p></div>\n      <div><h3>ご利用ガイド</h3><ul><li>送料：全国一律 550円</li><li>5,000円以上で送料無料</li><li>通常 2〜4 営業日で発送</li></ul></div>\n      <div><h3>お支払い方法</h3><ul><li>クレジットカード</li><li>コンビニ払い</li><li>代金引換</li></ul></div>\n    </div>\n    <div class=\"copy\">これはデモサイトです。実際の決済・発送は行われません。 © 2026 ひなたマーケット</div>\n  </div>\n</footer>\n<div id=\"toast\" role=\"status\"></div>\n\n<script>\n'use strict';\n\n/* ---------- データ ---------- */\nconst CATEGORIES = { all: 'すべて', fashion: 'ファッション', kitchen: 'キッチン', interior: 'インテリア', gadget: '家電・ガジェット', food: 'フード', stationery: '文具' };\n\nconst PRODUCTS = [\n  { id: 'p01', name: 'オーガニックコットン Tシャツ', cat: 'fashion', price: 3960, rating: 4.5, reviews: 128, stock: 24, emoji: '👕', hue: 200, isNew: true,\n    desc: '肌ざわりのやさしいオーガニックコットン100%。洗濯を重ねてもヨレにくい、しっかりとした生地感の定番Tシャツです。', spec: { 素材: '綿100%', サイズ: 'フリー（ユニセックス）', 生産国: '日本' } },\n  { id: 'p02', name: '帆布トートバッグ', cat: 'fashion', price: 5280, rating: 4.7, reviews: 86, stock: 12, emoji: '👜', hue: 35,\n    desc: '厚手の8号帆布を使った丈夫なトート。A4ファイルやノートPCがすっきり収まり、通勤にも休日にも活躍します。', spec: { 素材: '綿（8号帆布）', サイズ: '幅38 × 高さ32 × マチ12cm', 重量: '約420g' } },\n  { id: 'p03', name: 'ウールブレンド ニットキャップ', cat: 'fashion', price: 2750, rating: 4.2, reviews: 41, stock: 0, emoji: '🧢', hue: 280,\n    desc: 'チクチクしにくいウールブレンド糸で編んだニットキャップ。深めのシルエットで耳まであたたかく包みます。', spec: { 素材: 'ウール60%・アクリル40%', サイズ: 'フリー' } },\n  { id: 'p04', name: 'ステンレス ドリップケトル 0.7L', cat: 'kitchen', price: 6380, rating: 4.8, reviews: 213, stock: 9, emoji: '🫖', hue: 15,\n    desc: '細口ノズルで湯量をコントロールしやすいドリップケトル。IH・直火の両方に対応しています。', spec: { 素材: '18-8ステンレス', 容量: '0.7L', 対応熱源: 'IH / 直火' } },\n  { id: 'p05', name: '美濃焼 マグカップ', cat: 'kitchen', price: 1980, rating: 4.6, reviews: 157, stock: 40, emoji: '☕', hue: 25, isNew: true,\n    desc: '職人が一つずつ釉薬をかけて仕上げたマグカップ。手になじむ丸みのあるフォルムで、電子レンジ・食洗機に対応。', spec: { 素材: '磁器', 容量: '320ml', 対応: '電子レンジ / 食洗機' } },\n  { id: 'p06', name: 'ひのきのまな板', cat: 'kitchen', price: 4400, rating: 4.4, reviews: 62, stock: 15, emoji: '🪵', hue: 45,\n    desc: '国産ひのきの一枚板から作ったまな板。刃あたりがやわらかく、包丁を傷めにくいのが特長です。', spec: { 素材: 'ひのき（国産）', サイズ: '36 × 21 × 厚さ2.5cm' } },\n  { id: 'p07', name: 'リネン クッションカバー', cat: 'interior', price: 2420, rating: 4.3, reviews: 54, stock: 30, emoji: '🛋️', hue: 150,\n    desc: 'さらりとした質感のリネン100%。使い込むほどにやわらかくなり、お部屋にナチュラルな雰囲気を添えます。', spec: { 素材: '麻100%', サイズ: '45 × 45cm', 備考: '中材は別売り' } },\n  { id: 'p08', name: 'LEDデスクライト（調光・調色）', cat: 'interior', price: 7480, rating: 4.6, reviews: 98, stock: 7, emoji: '💡', hue: 55,\n    desc: '5段階の調光と3色の調色に対応。目にやさしい面発光で、読書やデスクワークを快適にします。', spec: { 消費電力: '8W', 給電: 'USB Type-C', 保証: '1年' } },\n  { id: 'p09', name: 'ワイヤレスイヤホン', cat: 'gadget', price: 9800, rating: 4.4, reviews: 342, stock: 18, emoji: '🎧', hue: 230,\n    desc: 'ノイズキャンセリング搭載の完全ワイヤレスイヤホン。ケース併用で最大30時間再生できます。', spec: { 連続再生: '最大8時間（ケース込み30時間）', 防水: 'IPX4', 充電: 'USB Type-C' } },\n  { id: 'p10', name: 'モバイルバッテリー 10000mAh', cat: 'gadget', price: 3980, rating: 4.5, reviews: 276, stock: 33, emoji: '🔋', hue: 130,\n    desc: '薄型・軽量で持ち運びやすい大容量バッテリー。スマートフォンを約2回フル充電できます。', spec: { 容量: '10000mAh', 出力: '最大20W', 重量: '約180g' } },\n  { id: 'p11', name: 'スペシャルティコーヒー豆 200g', cat: 'food', price: 1680, rating: 4.9, reviews: 189, stock: 50, emoji: '🫘', hue: 20,\n    desc: '注文を受けてから焙煎する中煎りブレンド。チョコレートのような甘みと、すっきりした後味が特長です。', spec: { 内容量: '200g（豆のまま）', 焙煎度: '中煎り', 賞味期限: '焙煎日より60日' } },\n  { id: 'p12', name: '国産はちみつ 250g', cat: 'food', price: 2160, rating: 4.7, reviews: 73, stock: 22, emoji: '🍯', hue: 42,\n    desc: '国内の養蜂家から届く非加熱の百花蜜。季節の花々の香りが広がる、まろやかな味わいです。', spec: { 内容量: '250g', 原材料: 'はちみつ（国産）', 備考: '1歳未満の乳児には与えないでください' } },\n  { id: 'p13', name: '焼き菓子アソートボックス', cat: 'food', price: 3240, rating: 4.6, reviews: 110, stock: 14, emoji: '🍪', hue: 30, isNew: true,\n    desc: 'フィナンシェ、マドレーヌ、クッキーなど8種を詰め合わせました。贈り物にもおすすめです。', spec: { 内容: '8種・計16個', 賞味期限: '製造日より30日', アレルゲン: '小麦・卵・乳・アーモンド' } },\n  { id: 'p14', name: 'A5 方眼ノート 3冊セット', cat: 'stationery', price: 1320, rating: 4.3, reviews: 67, stock: 60, emoji: '📓', hue: 210,\n    desc: '万年筆でも裏抜けしにくい上質紙を使用。180度フラットに開く糸かがり製本のノートです。', spec: { サイズ: 'A5', 罫線: '5mm方眼', ページ数: '各96ページ' } },\n  { id: 'p15', name: '真鍮ボールペン', cat: 'stationery', price: 3520, rating: 4.5, reviews: 45, stock: 5, emoji: '🖊️', hue: 50,\n    desc: '無垢の真鍮を削り出したボールペン。使い込むほどに色合いが深まり、自分だけの一本に育ちます。', spec: { 素材: '真鍮', インク: '油性・黒 0.7mm', 重量: '約28g' } },\n];\nconst byId = Object.fromEntries(PRODUCTS.map(p => [p.id, p]));\n\nconst SHIPPING_FEE = 550, FREE_SHIPPING = 5000, TAX_RATE = 0.1;\nconst PREFS = '北海道,青森県,岩手県,宮城県,秋田県,山形県,福島県,茨城県,栃木県,群馬県,埼玉県,千葉県,東京都,神奈川県,新潟県,富山県,石川県,福井県,山梨県,長野県,岐阜県,静岡県,愛知県,三重県,滋賀県,京都府,大阪府,兵庫県,奈良県,和歌山県,鳥取県,島根県,岡山県,広島県,山口県,徳島県,香川県,愛媛県,高知県,福岡県,佐賀県,長崎県,熊本県,大分県,宮崎県,鹿児島県,沖縄県'.split(',');\nconst PAYMENTS = { card: 'クレジットカード', cvs: 'コンビニ払い', cod: '代金引換' };\n\n/* ---------- 保存（localStorage が使えない環境ではメモリに保持） ---------- */\nconst mem = {};\nconst store = {\n  get(k, d) {\n    if (k in mem) return mem[k];\n    try { const v = localStorage.getItem('hinata:' + k); return v ? JSON.parse(v) : d; } catch { return d; }\n  },\n  set(k, v) { mem[k] = v; try { localStorage.setItem('hinata:' + k, JSON.stringify(v)); } catch {} },\n};\n\nconst state = {\n  cart: store.get('cart', {}),     // { 商品ID: 数量 }\n  favs: store.get('favs', []),     // [商品ID]\n  orders: store.get('orders', []),\n  q: '', cat: 'all', sort: 'recommended',\n};\n// 保存データに存在しない商品が残っていたら取り除く\nfor (const id of Object.keys(state.cart)) if (!byId[id] || !(state.cart[id] > 0)) delete state.cart[id];\nstate.favs = state.favs.filter(id => byId[id]);\n\n/* ---------- ユーティリティ ---------- */\nconst $ = s => document.querySelector(s);\nconst esc = s => String(s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst yen = n => '¥' + n.toLocaleString('ja-JP');\nconst stars = p => {\n  const full = Math.round(p.rating);\n  return `<span class=\"stars\" aria-label=\"評価 ${p.rating}（${p.reviews}件）\">${'★'.repeat(full)}${'☆'.repeat(5 - full)}<span>${p.rating.toFixed(1)}（${p.reviews}）</span></span>`;\n};\nconst thumb = p => `<div class=\"thumb\" style=\"--h:${p.hue}\" role=\"img\" aria-label=\"${esc(p.name)}の画像\">${p.emoji}</div>`;\n\nlet toastTimer;\nfunction toast(msg) {\n  const t = $('#toast');\n  t.textContent = msg; t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(() => t.classList.remove('show'), 2400);\n}\n\nfunction cartLines() {\n  return Object.entries(state.cart).map(([id, qty]) => ({ p: byId[id], qty }));\n}\nfunction totals() {\n  const lines = cartLines();\n  const subtotal = lines.reduce((s, l) => s + l.p.price * l.qty, 0);\n  const count = lines.reduce((s, l) => s + l.qty, 0);\n  const shipping = count === 0 || subtotal >= FREE_SHIPPING ? 0 : SHIPPING_FEE;\n  const total = subtotal + shipping;\n  const tax = Math.floor(total * TAX_RATE / (1 + TAX_RATE));\n  return { lines, subtotal, count, shipping, total, tax };\n}\nfunction saveCart() { store.set('cart', state.cart); updateBadge(); }\nfunction updateBadge() {\n  const { count } = totals(), b = $('#badge');\n  b.textContent = count; b.hidden = count === 0;\n}\n\nfunction addToCart(id, qty = 1) {\n  const p = byId[id];\n  if (!p || p.stock === 0) return;\n  const cur = state.cart[id] || 0;\n  const next = Math.min(cur + qty, p.stock);\n  if (next === cur) { toast(`在庫数の上限（${p.stock}点）に達しています`); return; }\n  state.cart[id] = next;\n  saveCart();\n  toast(next < cur + qty ? `在庫の都合により ${next} 点までカートに入れました` : `「${p.name}」をカートに追加しました`);\n}\nfunction setQty(id, qty) {\n  const p = byId[id];\n  if (!p) return;\n  if (qty <= 0) delete state.cart[id];\n  else {\n    if (qty > p.stock) toast(`在庫数の上限は ${p.stock} 点です`);\n    state.cart[id] = Math.min(qty, p.stock);\n  }\n  saveCart();\n}\nfunction toggleFav(id) {\n  const i = state.favs.indexOf(id);\n  if (i >= 0) state.favs.splice(i, 1); else state.favs.push(id);\n  store.set('favs', state.favs);\n  toast(i >= 0 ? 'お気に入りから削除しました' : 'お気に入りに追加しました');\n}\n\n/* ---------- 画面 ---------- */\nfunction productCard(p) {\n  const fav = state.favs.includes(p.id);\n  return `<article class=\"card item\">\n    <a href=\"#/product/${p.id}\" tabindex=\"-1\" aria-hidden=\"true\">${thumb(p)}</a>\n    ${p.stock === 0 ? '<span class=\"tag sold\">在庫切れ</span>' : p.isNew ? '<span class=\"tag\">NEW</span>' : ''}\n    <button class=\"fav\" data-act=\"fav\" data-id=\"${p.id}\" aria-pressed=\"${fav}\" aria-label=\"${esc(p.name)}をお気に入りに${fav ? 'から削除' : '追加'}\">${fav ? '♥' : '♡'}</button>\n    <div class=\"body\">\n      <span class=\"muted\">${CATEGORIES[p.cat]}</span>\n      <a class=\"name\" href=\"#/product/${p.id}\">${esc(p.name)}</a>\n      ${stars(p)}\n      <div class=\"foot\">\n        <span class=\"price\">${yen(p.price)}<small>税込</small></span>\n        <button class=\"btn sm\" data-act=\"add\" data-id=\"${p.id}\" ${p.stock === 0 ? 'disabled' : ''}>${p.stock === 0 ? '在庫切れ' : 'カートへ'}</button>\n      </div>\n    </div>\n  </article>`;\n}\n\nfunction filtered() {\n  const words = state.q.trim().toLowerCase().split(/\\s+/).filter(Boolean);\n  const list = PRODUCTS.filter(p => {\n    if (state.cat !== 'all' && p.cat !== state.cat) return false;\n    const hay = (p.name + ' ' + p.desc + ' ' + CATEGORIES[p.cat]).toLowerCase();\n    return words.every(w => hay.includes(w));\n  });\n  const sorters = {\n    'price-asc': (a, b) => a.price - b.price,\n    'price-desc': (a, b) => b.price - a.price,\n    rating: (a, b) => b.rating - a.rating || b.reviews - a.reviews,\n    new: (a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0),\n  };\n  if (sorters[state.sort]) list.sort(sorters[state.sort]);\n  return list;\n}\n\nfunction listView() {\n  const list = filtered();\n  const sorts = { recommended: 'おすすめ順', new: '新着順', 'price-asc': '価格が安い順', 'price-desc': '価格が高い順', rating: '評価が高い順' };\n  return `\n    ${state.q || state.cat !== 'all' ? '' : `<section class=\"hero\"><h1>暮らしに、ひなたのぬくもりを。</h1><p>毎日使いたくなる、衣・食・住のいいものを集めました。</p></section>`}\n    <div class=\"toolbar\">\n      <div class=\"chips\" role=\"group\" aria-label=\"カテゴリー\">\n        ${Object.entries(CATEGORIES).map(([k, v]) => `<button class=\"chip\" data-act=\"cat\" data-id=\"${k}\" aria-pressed=\"${state.cat === k}\">${v}</button>`).join('')}\n      </div>\n      <label class=\"sort\"><span class=\"muted\">並び替え：</span>\n        <select id=\"sort\">${Object.entries(sorts).map(([k, v]) => `<option value=\"${k}\" ${state.sort === k ? 'selected' : ''}>${v}</option>`).join('')}</select>\n      </label>\n    </div>\n    <p class=\"muted\">${state.q ? `「${esc(state.q)}」の検索結果：` : ''}${list.length} 件の商品</p>\n    ${list.length\n      ? `<div class=\"grid\">${list.map(productCard).join('')}</div>`\n      : `<div class=\"empty card\"><div class=\"big\">🔎</div><p>条件に合う商品が見つかりませんでした。</p><button class=\"btn ghost\" data-act=\"reset\">条件をクリアする</button></div>`}`;\n}\n\nfunction productView(id) {\n  const p = byId[id];\n  if (!p) return notFound();\n  const fav = state.favs.includes(p.id);\n  const related = PRODUCTS.filter(x => x.cat === p.cat && x.id !== p.id).slice(0, 4);\n  const inCart = state.cart[p.id] || 0;\n  return `\n    <p class=\"crumbs\"><a href=\"#/\">商品一覧</a> › <a href=\"#/\" data-act=\"cat\" data-id=\"${p.cat}\">${CATEGORIES[p.cat]}</a> › ${esc(p.name)}</p>\n    <section class=\"card detail\">\n      ${thumb(p)}\n      <div>\n        <span class=\"muted\">${CATEGORIES[p.cat]}</span>\n        <h1>${esc(p.name)}</h1>\n        ${stars(p)}\n        <div class=\"price\">${yen(p.price)}<small>税込</small></div>\n        ${p.stock === 0 ? '<span class=\"out-stock\">在庫切れ</span>'\n          : p.stock <= 9 ? `<span class=\"out-stock\">残り ${p.stock} 点</span>` : '<span class=\"in-stock\">在庫あり</span>'}\n        ${inCart ? `<span class=\"muted\">　カートに ${inCart} 点入っています</span>` : ''}\n        <div class=\"buy\">\n          <div class=\"qty\">\n            <button type=\"button\" data-act=\"q-dec\" aria-label=\"数量を減らす\">−</button>\n            <input id=\"qty\" type=\"number\" inputmode=\"numeric\" min=\"1\" max=\"${Math.max(p.stock, 1)}\" value=\"1\" aria-label=\"数量\" ${p.stock === 0 ? 'disabled' : ''}>\n            <button type=\"button\" data-act=\"q-inc\" aria-label=\"数量を増やす\">＋</button>\n          </div>\n          <button class=\"btn\" data-act=\"add\" data-id=\"${p.id}\" data-useqty=\"1\" ${p.stock === 0 ? 'disabled' : ''}>${p.stock === 0 ? '在庫切れ' : '🛒 カートに入れる'}</button>\n          <button class=\"btn ghost\" data-act=\"fav\" data-id=\"${p.id}\" aria-pressed=\"${fav}\">${fav ? '♥ お気に入り済み' : '♡ お気に入り'}</button>\n        </div>\n        <p>${esc(p.desc)}</p>\n        <table class=\"spec\"><tbody>${Object.entries(p.spec).map(([k, v]) => `<tr><th scope=\"row\">${esc(k)}</th><td>${esc(v)}</td></tr>`).join('')}</tbody></table>\n      </div>\n    </section>\n    ${related.length ? `<h2>関連商品</h2><div class=\"grid\">${related.map(productCard).join('')}</div>` : ''}`;\n}\n\nfunction summaryBox(t, action) {\n  const rest = FREE_SHIPPING - t.subtotal;\n  return `<aside class=\"card summary\">\n    <h2>ご注文内容</h2>\n    ${rest > 0 ? `<div class=\"ship-hint\">あと <b>${yen(rest)}</b> で送料無料</div>` : `<div class=\"ship-hint\">🎉 送料無料の対象です</div>`}\n    <dl>\n      <dt>小計（${t.count}点）</dt><dd>${yen(t.subtotal)}</dd>\n      <dt>送料</dt><dd>${t.shipping ? yen(t.shipping) : '無料'}</dd>\n      <dt class=\"total\">合計</dt><dd class=\"total\">${yen(t.total)}</dd>\n      <dt class=\"muted\">うち消費税（10%）</dt><dd class=\"muted\">${yen(t.tax)}</dd>\n    </dl>\n    ${action}\n  </aside>`;\n}\n\nfunction cartView() {\n  const t = totals();\n  if (!t.count) return `<h1>ショッピングカート</h1><div class=\"empty card\"><div class=\"big\">🛒</div><p>カートに商品が入っていません。</p><a class=\"btn\" href=\"#/\">お買い物を続ける</a></div>`;\n  return `<h1>ショッピングカート</h1>\n    <div class=\"cols\">\n      <section class=\"card rows\" aria-label=\"カートの商品\">\n        ${t.lines.map(({ p, qty }) => `<div class=\"row\">\n          <a href=\"#/product/${p.id}\">${thumb(p)}</a>\n          <div>\n            <a class=\"name\" href=\"#/product/${p.id}\"><b>${esc(p.name)}</b></a>\n            <div class=\"muted\">${yen(p.price)}（税込）</div>\n            <div class=\"ctl\">\n              <div class=\"qty\">\n                <button data-act=\"dec\" data-id=\"${p.id}\" aria-label=\"${esc(p.name)}の数量を減らす\">−</button>\n                <output aria-label=\"数量\">${qty}</output>\n                <button data-act=\"inc\" data-id=\"${p.id}\" aria-label=\"${esc(p.name)}の数量を増やす\" ${qty >= p.stock ? 'disabled' : ''}>＋</button>\n              </div>\n              <button class=\"link\" data-act=\"remove\" data-id=\"${p.id}\">削除</button>\n            </div>\n          </div>\n          <div class=\"price line-total\">${yen(p.price * qty)}</div>\n        </div>`).join('')}\n      </section>\n      ${summaryBox(t, `<a class=\"btn block\" href=\"#/checkout\">ご購入手続きへ</a><p style=\"text-align:center;margin:12px 0 0\"><a class=\"muted\" href=\"#/\" style=\"text-decoration:underline\">お買い物を続ける</a></p>`)}\n    </div>`;\n}\n\nconst FIELDS = [\n  { id: 'name', label: 'お名前', ac: 'name', ph: '山田 太郎', test: v => v.length > 0, msg: 'お名前を入力してください' },\n  { id: 'email', label: 'メールアドレス', type: 'email', ac: 'email', ph: 'taro@example.com', test: v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v), msg: 'メールアドレスを正しく入力してください' },\n  { id: 'tel', label: '電話番号', type: 'tel', ac: 'tel', ph: '09012345678', test: v => /^0\\d{9,10}$/.test(v.replace(/[-\\s]/g, '')), msg: '電話番号を正しく入力してください（例：09012345678）' },\n  { id: 'zip', label: '郵便番号', ac: 'postal-code', ph: '100-0001', test: v => /^\\d{3}-?\\d{4}$/.test(v), msg: '郵便番号は7桁の数字で入力してください（例：100-0001）' },\n  { id: 'pref', label: '都道府県', ac: 'address-level1', select: true, test: v => PREFS.includes(v), msg: '都道府県を選択してください' },\n  { id: 'addr', label: '市区町村・番地・建物名', ac: 'street-address', ph: '千代田区千代田1-1 ひなたビル101', test: v => v.length > 0, msg: '住所を入力してください' },\n];\n\nfunction checkoutView() {\n  const t = totals();\n  if (!t.count) { location.replace('#/cart'); return ''; }\n  const field = f => `<div class=\"field\">\n      <label for=\"f-${f.id}\">${f.label}<span class=\"req\">必須</span></label>\n      ${f.select\n        ? `<select id=\"f-${f.id}\" name=\"${f.id}\" autocomplete=\"${f.ac}\" aria-describedby=\"e-${f.id}\"><option value=\"\">選択してください</option>${PREFS.map(x => `<option>${x}</option>`).join('')}</select>`\n        : `<input id=\"f-${f.id}\" name=\"${f.id}\" type=\"${f.type || 'text'}\" autocomplete=\"${f.ac}\" placeholder=\"${f.ph}\" aria-describedby=\"e-${f.id}\">`}\n      <div class=\"err\" id=\"e-${f.id}\" role=\"alert\"></div>\n    </div>`;\n  const F = Object.fromEntries(FIELDS.map(f => [f.id, field(f)]));\n  return `<p class=\"crumbs\"><a href=\"#/cart\">カート</a> › ご購入手続き</p>\n    <h1>ご購入手続き</h1>\n    <div class=\"cols\">\n      <form class=\"card checkout\" id=\"checkout\" novalidate>\n        <fieldset><legend>お客様情報</legend>${F.name}<div class=\"two\">${F.email}${F.tel}</div></fieldset>\n        <fieldset><legend>お届け先</legend><div class=\"two\">${F.zip}${F.pref}</div>${F.addr}</fieldset>\n        <fieldset><legend>お支払い方法</legend>\n          ${Object.entries(PAYMENTS).map(([k, v], i) => `<label class=\"radio\"><input type=\"radio\" name=\"pay\" value=\"${k}\" ${i === 0 ? 'checked' : ''}>${v}</label>`).join('')}\n          <p class=\"muted\">※ デモサイトのため、カード情報の入力や実際の決済は行われません。</p>\n        </fieldset>\n        <fieldset><legend>備考</legend>\n          <div class=\"field\"><label for=\"f-note\">ご要望など（任意）</label><textarea id=\"f-note\" name=\"note\" rows=\"3\" maxlength=\"500\"></textarea></div>\n        </fieldset>\n        <button class=\"btn block\" type=\"submit\">注文を確定する（${yen(t.total)}）</button>\n      </form>\n      ${summaryBox(t, `<ul class=\"mini\">${t.lines.map(l => `<li><span>${esc(l.p.name)} × ${l.qty}</span><span>${yen(l.p.price * l.qty)}</span></li>`).join('')}</ul><a class=\"btn ghost block\" href=\"#/cart\">カートを編集する</a>`)}\n    </div>`;\n}\n\nfunction submitOrder(form) {\n  const data = Object.fromEntries(new FormData(form));\n  let firstBad = null;\n  for (const f of FIELDS) {\n    const el = form.elements[f.id], ok = f.test(String(data[f.id] || '').trim());\n    el.setAttribute('aria-invalid', String(!ok));\n    $('#e-' + f.id).textContent = ok ? '' : f.msg;\n    if (!ok && !firstBad) firstBad = el;\n  }\n  if (firstBad) { firstBad.focus(); toast('入力内容をご確認ください'); return; }\n\n  const t = totals();\n  if (!t.count) { location.hash = '#/cart'; return; }\n  const now = new Date();\n  const order = {\n    id: 'HM' + now.toISOString().slice(2, 10).replace(/-/g, '') + '-' + Math.random().toString(36).slice(2, 7).toUpperCase(),\n    date: now.toISOString(),\n    items: t.lines.map(l => ({ id: l.p.id, name: l.p.name, price: l.p.price, qty: l.qty })),\n    subtotal: t.subtotal, shipping: t.shipping, total: t.total,\n    pay: PAYMENTS[data.pay] ? data.pay : 'card',\n    customer: Object.fromEntries(FIELDS.map(f => [f.id, String(data[f.id]).trim()])),\n    note: String(data.note || '').trim(),\n  };\n  state.orders.unshift(order);\n  store.set('orders', state.orders);\n  state.cart = {};\n  saveCart();\n  location.hash = '#/complete/' + order.id;\n}\n\nfunction orderBody(o) {\n  return `<ul class=\"mini\">${o.items.map(i => `<li><span>${esc(i.name)} × ${i.qty}</span><span>${yen(i.price * i.qty)}</span></li>`).join('')}\n      <li class=\"muted\"><span>送料</span><span>${o.shipping ? yen(o.shipping) : '無料'}</span></li>\n      <li><b>合計（税込）</b><b>${yen(o.total)}</b></li></ul>\n    <p class=\"muted\">お届け先：〒${esc(o.customer.zip)} ${esc(o.customer.pref)}${esc(o.customer.addr)}　${esc(o.customer.name)} 様<br>お支払い方法：${PAYMENTS[o.pay]}</p>`;\n}\nconst fmtDate = iso => new Date(iso).toLocaleString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });\n\nfunction completeView(id) {\n  const o = state.orders.find(x => x.id === id);\n  if (!o) return notFound();\n  return `<section class=\"card done\">\n      <div style=\"font-size:54px\">🎉</div>\n      <h1>ご注文ありがとうございます</h1>\n      <p>ご注文を承りました。確認メールを <b>${esc(o.customer.email)}</b> 宛にお送りします（デモのため実際には送信されません）。</p>\n      <p>注文番号：<b>${esc(o.id)}</b></p>\n      ${orderBody(o)}\n      <div class=\"buy\" style=\"justify-content:center\"><a class=\"btn\" href=\"#/\">お買い物を続ける</a><a class=\"btn ghost\" href=\"#/orders\">注文履歴を見る</a></div>\n    </section>`;\n}\n\nfunction ordersView() {\n  if (!state.orders.length) return `<h1>注文履歴</h1><div class=\"empty card\"><div class=\"big\">📦</div><p>まだ注文履歴がありません。</p><a class=\"btn\" href=\"#/\">商品を見る</a></div>`;\n  return `<h1>注文履歴</h1>${state.orders.map(o => `<section class=\"card order\">\n      <div class=\"order-head\"><b>注文番号：${esc(o.id)}</b><span class=\"muted\">${fmtDate(o.date)}</span></div>\n      ${orderBody(o)}\n    </section>`).join('')}`;\n}\n\nfunction favoritesView() {\n  const list = state.favs.map(id => byId[id]).filter(Boolean);\n  return `<h1>お気に入り</h1>${list.length\n    ? `<div class=\"grid\">${list.map(productCard).join('')}</div>`\n    : `<div class=\"empty card\"><div class=\"big\">♡</div><p>お気に入りに登録した商品はありません。</p><a class=\"btn\" href=\"#/\">商品を見る</a></div>`}`;\n}\n\nfunction notFound() {\n  return `<div class=\"empty card\"><div class=\"big\">🤔</div><p>お探しのページは見つかりませんでした。</p><a class=\"btn\" href=\"#/\">トップへ戻る</a></div>`;\n}\n\n/* ---------- ルーティング ---------- */\nfunction parseRoute() {\n  const [page = '', arg = ''] = location.hash.replace(/^#\\/?/, '').split('/');\n  return { page, arg: decodeURIComponent(arg) };\n}\nconst TITLES = { '': '', cart: 'カート', checkout: 'ご購入手続き', complete: 'ご注文完了', orders: '注文履歴', favorites: 'お気に入り' };\n\nfunction render() {\n  const { page, arg } = parseRoute();\n  const views = { '': listView, product: () => productView(arg), cart: cartView, checkout: checkoutView, complete: () => completeView(arg), orders: ordersView, favorites: favoritesView };\n  const focusId = document.activeElement && document.activeElement.id;\n  $('#app').innerHTML = (views[page] || notFound)();\n  if (focusId && focusId !== 'q') { const el = document.getElementById(focusId); if (el) el.focus(); }\n  document.querySelectorAll('nav.main a').forEach(a => a.classList.toggle('on', a.dataset.nav === page));\n  const sub = page === 'product' && byId[arg] ? byId[arg].name : TITLES[page];\n  document.title = (sub ? sub + ' | ' : '') + 'ひなたマーケット';\n  updateBadge();\n}\nwindow.addEventListener('hashchange', () => { render(); window.scrollTo(0, 0); });\n\n/* ---------- イベント ---------- */\ndocument.addEventListener('click', e => {\n  const el = e.target.closest('[data-act]');\n  if (!el) return;\n  const { act, id } = el.dataset;\n  const qtyInput = $('#qty');\n  const clampQty = v => { const max = +qtyInput.max || 1; return Math.min(Math.max(Math.floor(v) || 1, 1), max); };\n  switch (act) {\n    case 'add': addToCart(id, el.dataset.useqty && qtyInput ? clampQty(+qtyInput.value) : 1); break;\n    case 'fav': toggleFav(id); break;\n    case 'inc': setQty(id, (state.cart[id] || 0) + 1); break;\n    case 'dec': setQty(id, (state.cart[id] || 0) - 1); break;\n    case 'remove': setQty(id, 0); toast('カートから削除しました'); break;\n    case 'q-inc': if (!qtyInput.disabled) qtyInput.value = clampQty(+qtyInput.value + 1); return;\n    case 'q-dec': if (!qtyInput.disabled) qtyInput.value = clampQty(+qtyInput.value - 1); return;\n    case 'cat':\n      state.cat = id;\n      if (parseRoute().page !== '') { e.preventDefault(); location.hash = '#/'; return; }\n      break;\n    case 'reset': state.q = ''; state.cat = 'all'; $('#q').value = ''; break;\n  }\n  render();\n});\n\ndocument.addEventListener('change', e => {\n  if (e.target.id === 'sort') { state.sort = e.target.value; render(); }\n  if (e.target.id === 'qty') { const max = +e.target.max || 1; e.target.value = Math.min(Math.max(Math.floor(+e.target.value) || 1, 1), max); }\n});\n\ndocument.addEventListener('submit', e => {\n  if (e.target.id === 'checkout') { e.preventDefault(); submitOrder(e.target); }\n});\n\n$('#q').addEventListener('input', e => {\n  state.q = e.target.value;\n  if (parseRoute().page !== '') location.hash = '#/'; else render();\n});\n$('#q').addEventListener('keydown', e => { if (e.key === 'Enter') e.target.blur(); });\n\n// 別タブでの変更を反映\nwindow.addEventListener('storage', () => {\n  delete mem.cart; delete mem.favs; delete mem.orders;\n  state.cart = store.get('cart', {}); state.favs = store.get('favs', []); state.orders = store.get('orders', []);\n  if (parseRoute().page !== 'checkout') render(); else updateBadge();\n});\n\nrender();\n</script>\n</body>\n</html>\n"
  }
}
