{
  "description": "watashi plugin hooks",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/watashi.ts", "hook", "stop"],
            "async": true
          }
        ]
      }
    ]
  }
}
