files=$(git diff --cached --name-only)

if echo "$files" | grep -qE '^(skills/[^/]+/SKILL\.md|README\.md|scripts/update-readme\.mjs)$'; then
  vp run readme
  git add README.md
fi

if echo "$files" | grep -qE '^(skills/writing/|scripts/update-writing-index\.mjs$)'; then
  vp run writing-index
  git add skills/writing/SKILL.md
fi
